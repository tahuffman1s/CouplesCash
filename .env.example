# CouplesCash environment — copy to .env (make setup does this) and fill in.
# .env is git-ignored. Never commit real values.
#
# Generate strong secrets with:   make secrets
#   JWT_SECRET        ← openssl rand -base64 48   (≥ 256-bit, HS256)
#   POSTGRES_PASSWORD ← openssl rand -hex 24
#
# How these map to container environment (see compose.yml):
#   POSTGRES_PASSWORD → db: POSTGRES_PASSWORD
#                     → api/migrate: ConnectionStrings__Default=Host=db;Port=5432;Database=couplescash;Username=couplescash;Password=${POSTGRES_PASSWORD}
#   JWT_SECRET        → api/migrate: Jwt__Secret
#   API_ENABLE_DOCS   → api: Api__EnableDocs            (Scalar UI at /scalar)
#   ASPNETCORE_ENVIRONMENT → api: ASPNETCORE_ENVIRONMENT
#   PUBLIC_URL        → web: ORIGIN                     (CSRF origin check)
#                     → api: WebAuthn__Origin           (passkeys; rpId = its host)
#   VAPID_PUBLIC_KEY  → api: Push__VapidPublicKey       (Web Push signing)
#   VAPID_PRIVATE_KEY → api: Push__VapidPrivateKey
#   VAPID_SUBJECT     → api: Push__Subject              (mailto: contact for push services)
#   TUNNEL_TOKEN      → cloudflared: TUNNEL_TOKEN       (profile "tunnel")

# --- Secrets (filled by `make secrets`) -------------------------------------
# Password for the `couplescash` Postgres role. Changing it after first boot
# requires `ALTER ROLE couplescash PASSWORD '...'` in the running db as well.
POSTGRES_PASSWORD=

# HS256 signing key for access tokens. Rotating it signs everyone out
# (see docs/SECURITY.md → "Rotating JWT_SECRET").
JWT_SECRET=

# --- Web Push (reminders, partner activity) ---------------------------------
# VAPID key pair (P-256, base64url) that signs every push message. Generated by
# `make vapid` (part of `make secrets` and install.sh) with
# `dotnet CouplesCash.Api.dll --vapid`. Leave both empty to disable push: the
# API answers 503 push_not_configured and the web hides the Notifications UI.
# Rotating the pair silently drops every phone's subscription — each device
# must re-enable notifications (docs/NOTIFICATIONS.md).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services (Apple, Google, Mozilla) may use if your server
# misbehaves. Must be a mailto: (or https:) URL. install.sh fills it in.
VAPID_SUBJECT=mailto:you@example.com

# --- Public URL -------------------------------------------------------------
# The exact origin users type in the browser: scheme + host, no trailing
# slash. Becomes `ORIGIN` for the web container; if it does not match, every
# form POST fails with 403. For a LAN-only test use http://<pi-ip>:3000.
# Also the WebAuthn origin: passkeys are bound to this host (rpId), so changing
# the hostname later invalidates every registered passkey (docs/PASSKEYS.md).
# Push + passkeys need https:// and are hidden in the app on plain http://.
PUBLIC_URL=https://cash.example.com

# --- Cloudflare Tunnel (optional, `make tunnel-up`) -------------------------
# Token from Zero Trust → Networks → Tunnels → your tunnel → Install connector.
# See infra/cloudflared/README.md.
TUNNEL_TOKEN=

# --- API --------------------------------------------------------------------
# Production | Development. Development enables verbose errors — never on the Pi.
ASPNETCORE_ENVIRONMENT=Production
# true exposes interactive API docs at http://api:8080/scalar (internal network
# only, but keep it off in production anyway).
API_ENABLE_DOCS=false

# --- Optional knobs ---------------------------------------------------------
# Interface the web container binds on the host. 127.0.0.1 = reachable only
# from the Pi itself (the tunnel still works). 0.0.0.0 = whole LAN.
WEB_BIND=127.0.0.1
# Pull a different image build. Defaults to GHCR images published by CI.
IMAGE_PREFIX=ghcr.io/tahuffman1s
IMAGE_TAG=latest
# Container time zone (affects logs only; the app stores UTC — reminders use
# the household's time zone from Settings, not this).
TZ=UTC
# false pauses the in-api background job (autopay, reminders, hygiene).
# SCHEDULER_ENABLED=true
# Set to "tunnel" to start cloudflared with a plain `make up` as well.
# COMPOSE_PROFILES=tunnel
