# Normalise line endings: LF in the repo, LF on checkout (Linux-first project).
* text=auto eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.cs text eol=lf
*.svelte text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.sql.gz binary

# Keep generated lockfiles out of merge noise
pnpm-lock.yaml -diff
