# CouplesCash API — sample requests for the VS Code REST Client extension.
# Run the API (dotnet run --project CouplesCash.Api), then send the requests top to bottom.
# Variables captured from responses are reused automatically.

@host = http://localhost:8080
@email = alex@example.com
@password = correct horse battery staple
@partnerEmail = sam@example.com

### Health (no auth)
GET {{host}}/health

### Register
# @name register
POST {{host}}/v1/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "displayName": "Alex"
}

### Login
# @name login
POST {{host}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

### Me
GET {{host}}/v1/auth/me
Authorization: Bearer {{accessToken}}

### Update display name
PATCH {{host}}/v1/auth/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "displayName": "Alex J." }

### Create a Couple Code (also creates the household on first call)
# @name code
POST {{host}}/v1/couple/code
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Alex & Sam" }

### Refresh so the access token carries the new hh claim
# @name refresh
POST {{host}}/v1/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

@accessToken = {{refresh.response.body.accessToken}}
@refreshToken = {{refresh.response.body.refreshToken}}

### Partner registers
# @name partner
POST {{host}}/v1/auth/register
Content-Type: application/json

{
  "email": "{{partnerEmail}}",
  "password": "{{password}}",
  "displayName": "Sam"
}

@partnerToken = {{partner.response.body.accessToken}}

### Partner joins with the typed code (dashes/case ignored; the cc1. payload works too)
# @name join
POST {{host}}/v1/couple/join
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{ "code": "{{code.response.body.code}}" }

@partnerToken = {{join.response.body.accessToken}}

### Household
GET {{host}}/v1/couple
Authorization: Bearer {{accessToken}}

### Categories (12 defaults seeded)
# @name categories
GET {{host}}/v1/categories
Authorization: Bearer {{accessToken}}

### Create an account
# @name account
POST {{host}}/v1/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Joint checking",
  "institution": "Credit Union",
  "type": "checking",
  "balanceCents": 254000,
  "color": "#3b82f6",
  "icon": "landmark"
}

### Update balance (appends a snapshot)
POST {{host}}/v1/accounts/{{account.response.body.id}}/balance
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "balanceCents": 249000 }

### Balance history
GET {{host}}/v1/accounts/{{account.response.body.id}}/history?limit=10
Authorization: Bearer {{accessToken}}

### Create a monthly bill anchored on the 31st (clamps to month end)
# @name rent
POST {{host}}/v1/recurring
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Rent",
  "kind": "bill",
  "amountCents": 185000,
  "categoryId": "{{categories.response.body.0.id}}",
  "accountId": "{{account.response.body.id}}",
  "frequency": "monthly",
  "anchorDate": "2024-01-31",
  "autoPay": false,
  "notes": "Due last day of month"
}

### Calendar: Feb 2024 (expects Rent on 2024-02-29)
GET {{host}}/v1/calendar?from=2024-02-01&to=2024-02-29
Authorization: Bearer {{accessToken}}

### Mark the Feb 29 occurrence paid
PUT {{host}}/v1/recurring/{{rent.response.body.id}}/occurrences/2024-02-29/paid
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "amountCents": 185000 }

### Not a real occurrence → 404
PUT {{host}}/v1/recurring/{{rent.response.body.id}}/occurrences/2024-02-28/paid
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Un-mark
DELETE {{host}}/v1/recurring/{{rent.response.body.id}}/occurrences/2024-02-29/paid
Authorization: Bearer {{accessToken}}

### Summary for a month
GET {{host}}/v1/summary?month=2024-02
Authorization: Bearer {{accessToken}}

### ---------------------------------------------------------------------------------------------
### v2
### ---------------------------------------------------------------------------------------------

### Household settings (all fields optional; null clears defaultAccountId / payAnchorDate)
PATCH {{host}}/v1/couple
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currency": "USD",
  "weekStart": 1,
  "timezone": "America/Chicago",
  "defaultAccountId": "{{account.response.body.id}}",
  "payPeriod": "biweekly",
  "payAnchorDate": "2026-01-09"
}

### Pay period view (default: today in the household time zone)
GET {{host}}/v1/payperiod?date=2026-02-03
Authorization: Bearer {{accessToken}}

### Record an expense (deducts from the account + snapshot; deduct defaults to true when accountId is set)
# @name expense
POST {{host}}/v1/expenses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Groceries run",
  "amountCents": 4210,
  "categoryId": "{{categories.response.body.4.id}}",
  "accountId": "{{account.response.body.id}}",
  "spentOn": "2024-02-15",
  "note": "weekly shop"
}

### Expenses of a month (or ?from=&to=, ≤ 93 days)
GET {{host}}/v1/expenses?month=2024-02
Authorization: Bearer {{accessToken}}

### Delete the expense (reverses the deduction)
DELETE {{host}}/v1/expenses/{{expense.response.body.id}}
Authorization: Bearer {{accessToken}}

### Set a monthly budget for Housing (returns the row for ?month, default current)
PUT {{host}}/v1/budgets/{{categories.response.body.0.id}}?month=2024-02
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "amountCents": 200000 }

### Budget rows for a month (every category)
GET {{host}}/v1/budgets?month=2024-02
Authorization: Bearer {{accessToken}}

### Clear the budget
DELETE {{host}}/v1/budgets/{{categories.response.body.0.id}}
Authorization: Bearer {{accessToken}}

### v4: weekly spending target (null clears)
PATCH {{host}}/v1/couple
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "weeklySpendCents": 20000 }

### v4: set a weekly budget for Transportation (returns its WeekBudgetRow for the current week)
PUT {{host}}/v1/budgets/{{categories.response.body.3.id}}?period=weekly
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "amountCents": 5000 }

### v4: weekly budget view (overall target, budgeted categories, 8-week history) — ?start= any date in the week
GET {{host}}/v1/budgets/week
Authorization: Bearer {{accessToken}}

### v4: plan a one-off that the bank will clear ("Bank shows it as" seeds a payee rule)
# @name oneoff
POST {{host}}/v1/recurring
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Oil change",
  "kind": "bill",
  "amountCents": 6000,
  "categoryId": "{{categories.response.body.3.id}}",
  "accountId": "{{account.response.body.id}}",
  "frequency": "once",
  "anchorDate": "{{$datetime 'YYYY-MM-DD'}}",
  "payeeHint": "JIFFY LUBE"
}

### v4: the week view (days, overdue, left at end of week, weekly budgets); ?start=YYYY-MM-DD for another week
GET {{host}}/v1/week
Authorization: Bearer {{accessToken}}

### v4: clear the weekly budget (monthly rows are untouched)
DELETE {{host}}/v1/budgets/{{categories.response.body.3.id}}?period=weekly
Authorization: Bearer {{accessToken}}

### To-pay: add an item
# @name todo
POST {{host}}/v1/todos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Transfer $200 to savings", "amountCents": 20000, "dueDate": "2026-12-01" }

### To-pay: open items (?includeDone=true appends the last 30 days of done items)
GET {{host}}/v1/todos?includeDone=true
Authorization: Bearer {{accessToken}}

### To-pay: check off / un-check
POST {{host}}/v1/todos/{{todo.response.body.id}}/done
Authorization: Bearer {{accessToken}}

###
DELETE {{host}}/v1/todos/{{todo.response.body.id}}/done
Authorization: Bearer {{accessToken}}

### To-pay: reorder (sortOrder = position)
PUT {{host}}/v1/todos/order
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "ids": ["{{todo.response.body.id}}"] }

### Goals: create a manual goal
# @name goal
POST {{host}}/v1/goals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Vacation", "targetCents": 300000, "targetDate": "2027-06-01", "color": "#f43f5e", "icon": "plane" }

### Goals: contribute (manual goals only; negative takes money out)
POST {{host}}/v1/goals/{{goal.response.body.id}}/contribute
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "amountCents": 50000 }

### Goals: list with pace / projection / history
GET {{host}}/v1/goals
Authorization: Bearer {{accessToken}}

### Goals: account-linked goal (current = account balance; contribute → 400)
POST {{host}}/v1/goals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Emergency fund", "targetCents": 1000000, "accountId": "{{account.response.body.id}}" }

### Activity feed (newest first; follow nextBefore for older pages)
GET {{host}}/v1/activity?limit=30
Authorization: Bearer {{accessToken}}

### Month-close report
GET {{host}}/v1/reports/month?month=2024-02
Authorization: Bearer {{accessToken}}

### Push: VAPID public key (503 push_not_configured until Push__Vapid* are set)
GET {{host}}/v1/push/vapid-public-key
Authorization: Bearer {{accessToken}}

### Push: register a subscription (what PushManager.subscribe() returns)
POST {{host}}/v1/push/subscriptions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "endpoint": "https://fcm.googleapis.com/fcm/send/example",
  "keys": { "p256dh": "BPUBLICKEY…", "auth": "AUTHSECRET…" },
  "userAgent": "Travis's iPhone"
}

### Push: preferences (defaults created on first GET)
GET {{host}}/v1/push/prefs
Authorization: Bearer {{accessToken}}

###
PUT {{host}}/v1/push/prefs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "remindersEnabled": true, "daysBefore": [0, 1, 3], "hourLocal": 20, "activityEnabled": true }

### Push: send a test notification to my devices (202; delivered in the background)
POST {{host}}/v1/push/test
Authorization: Bearer {{accessToken}}

### Push: remove a subscription by endpoint or id
DELETE {{host}}/v1/push/subscriptions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "endpoint": "https://fcm.googleapis.com/fcm/send/example" }

### Passkeys: availability (anonymous)
GET {{host}}/v1/auth/passkeys/config

### Passkeys: start registration (PublicKeyCredentialCreationOptionsJSON for navigator.credentials.create)
# @name passkeyOptions
POST {{host}}/v1/auth/passkeys/register/options
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Travis's iPhone" }

### Passkeys: finish registration — credential = RegistrationResponseJSON from @simplewebauthn/browser startRegistration()
POST {{host}}/v1/auth/passkeys/register
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "challengeId": "{{passkeyOptions.response.body.challengeId}}",
  "name": "Travis's iPhone",
  "credential": { "id": "…", "rawId": "…", "type": "public-key", "response": { "clientDataJSON": "…", "attestationObject": "…", "transports": ["internal"] }, "clientExtensionResults": {} }
}

### Passkeys: list / delete
GET {{host}}/v1/auth/passkeys
Authorization: Bearer {{accessToken}}

### Passkeys: sign in (anonymous) — discoverable credential, no email
# @name loginOptions
POST {{host}}/v1/auth/passkeys/login/options
Content-Type: application/json

{}

###
POST {{host}}/v1/auth/passkeys/login
Content-Type: application/json

{
  "challengeId": "{{loginOptions.response.body.challengeId}}",
  "credential": { "id": "…", "rawId": "…", "type": "public-key", "response": { "clientDataJSON": "…", "authenticatorData": "…", "signature": "…", "userHandle": "…" }, "clientExtensionResults": {} }
}

### ---------------------------------------------------------------------------------------------
### v3 — bank sync, inbox, CSV import
### ---------------------------------------------------------------------------------------------

### Banks: list links with external accounts (works without Security__DataKey; lastError = "encryption key missing")
GET {{host}}/v1/banks
Authorization: Bearer {{accessToken}}

### Banks: claim a SimpleFIN setup token (base64 of the claim URL from https://beta-bridge.simplefin.org/simplefin/create)
### 503 bank_sync_not_configured without Security__DataKey · 400 errors.setupToken when invalid/claimed · 502 when the Bridge is down
# @name link
POST {{host}}/v1/banks/simplefin/claim
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "setupToken": "aHR0cHM6Ly9iZXRhLWJyaWRnZS5zaW1wbGVmaW4ub3JnL3NpbXBsZWZpbi9jbGFpbS9ERU1P", "name": "Chase" }

### Banks: map an external account to an existing account (applies the balance + snapshot right away)
PUT {{host}}/v1/banks/accounts/{{link.response.body.accounts.0.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "accountId": "{{account.response.body.id}}" }

### Banks: or create the CouplesCash account from the bank account (type guessed from the name unless given)
PUT {{host}}/v1/banks/accounts/{{link.response.body.accounts.1.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "create": { "name": "Visa", "type": "credit" } }

### Banks: sync now (429 + Retry-After inside the 15-minute manual cooldown)
POST {{host}}/v1/banks/{{link.response.body.id}}/sync
Authorization: Bearer {{accessToken}}

### Banks: rename / pause
PATCH {{host}}/v1/banks/{{link.response.body.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Chase (joint)", "syncEnabled": true }

### Inbox: dashboard summary
GET {{host}}/v1/inbox/summary
Authorization: Bearer {{accessToken}}

### Inbox: pending rows, newest first (follow nextBefore: "YYYY-MM-DD_<id>")
# @name inbox
GET {{host}}/v1/inbox?status=pending&limit=50
Authorization: Bearer {{accessToken}}

### Inbox: confirm as an expense (category defaults to the suggestion; deduct=false; learns the payee rule)
POST {{host}}/v1/inbox/{{inbox.response.body.items.0.id}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "as": "expense", "categoryId": "{{categories.response.body.4.id}}", "name": "Weekly shop" }

### Inbox: confirm as a bill payment (marks the occurrence paid with the actual amount, source "bank")
POST {{host}}/v1/inbox/{{inbox.response.body.items.1.id}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "as": "occurrence", "itemId": "{{rent.response.body.id}}", "dueDate": "2024-02-29" }

### Inbox: ignore / restore
POST {{host}}/v1/inbox/{{inbox.response.body.items.2.id}}/ignore
Authorization: Bearer {{accessToken}}

###
POST {{host}}/v1/inbox/{{inbox.response.body.items.2.id}}/restore
Authorization: Bearer {{accessToken}}

### Inbox: confirm every pending row with confidence ≥ 70 using its suggestion (no ids = all pending)
POST {{host}}/v1/inbox/bulk
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "action": "confirm-suggested" }

### CSV import: normalised rows (the web parses the file; ≤ 5000 rows, body ≤ 2 MB on this route)
POST {{host}}/v1/imports/csv
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "accountId": "{{account.response.body.id}}",
  "filename": "statement.csv",
  "rows": [
    { "postedOn": "2026-10-02", "amountCents": -1249, "description": "KROGER #123", "payee": "Kroger" },
    { "postedOn": "2026-10-03", "amountCents": -4000, "description": "SHELL OIL 12345", "memo": "fuel" },
    { "postedOn": "2026-10-15", "amountCents": 320000, "description": "ACME PAYROLL" }
  ]
}

### CSV import: history (last 20)
GET {{host}}/v1/imports/csv
Authorization: Bearer {{accessToken}}

### v5: account transactions (bank rows + manual expenses), filters all|pending|review|matched|transfers, search, month, keyset
GET {{host}}/v1/accounts/{{account.response.body.id}}/transactions?filter=all&q=kroger&month=2026-10&limit=50
Authorization: Bearer {{accessToken}}

### v5: ranked bill/income candidates (±30 days) and transfer peers for one row
GET {{host}}/v1/inbox/{{inbox.response.body.items.0.id}}/candidates?days=30
Authorization: Bearer {{accessToken}}

### v5: match a row in any status to an occurrence (reverses a previous expense/transfer; 409 when paid by something else)
POST {{host}}/v1/inbox/{{inbox.response.body.items.0.id}}/match
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "itemId": "{{rent.response.body.id}}", "dueDate": "2026-10-31" }

### v5: back to To review from any status (reverses expense / payment / transfer and the transfer peer)
POST {{host}}/v1/inbox/{{inbox.response.body.items.0.id}}/unmatch
Authorization: Bearer {{accessToken}}

### v5: mark as transfer — with peerId pairs both rows; without it the row is one-sided and its payee is learned
POST {{host}}/v1/inbox/{{inbox.response.body.items.1.id}}/transfer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "peerId": null }

### v5: create a bill from a transaction (anchor = its date, amount = |amount|, payeeHint = payee) and match it
# @name fromTx
POST {{host}}/v1/recurring/from-transaction
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "transactionId": "{{inbox.response.body.items.0.id}}", "name": "Gym", "kind": "subscription", "frequency": "monthly" }

### v5: bill payments (next occurrence + the last 12, with the paying transaction and variance)
GET {{host}}/v1/recurring/{{rent.response.body.id}}/payments?limit=12
Authorization: Bearer {{accessToken}}

### v5: unmatched transactions around a due date (occurrence side)
GET {{host}}/v1/recurring/{{rent.response.body.id}}/occurrences/2026-10-31/candidates?days=10
Authorization: Bearer {{accessToken}}

### v5: pay an occurrence with a transaction
POST {{host}}/v1/recurring/{{rent.response.body.id}}/occurrences/2026-10-31/link
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "transactionId": "{{inbox.response.body.items.0.id}}" }

### v5: transfer report for a month
GET {{host}}/v1/transfers?month=2026-10
Authorization: Bearer {{accessToken}}

### v5: household setting — auto-ignore detected transfer pairs (default true)
PATCH {{host}}/v1/couple
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "autoIgnoreTransfers": false }

### v5: inbox including dropped / superseded authorizations
GET {{host}}/v1/inbox?status=ignored&includeHidden=1
Authorization: Bearer {{accessToken}}

### Banks: unlink (inbox rows and mapped accounts are kept)
DELETE {{host}}/v1/banks/{{link.response.body.id}}
Authorization: Bearer {{accessToken}}

### Logout (revokes the refresh token)
POST {{host}}/v1/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }
