{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "AccessMinutes": 15,
    "RefreshDays": 30
  },
  "Api": {
    "EnableDocs": false,
    "AllowedOrigins": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "GlobalPerMinute": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Npgsql": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
