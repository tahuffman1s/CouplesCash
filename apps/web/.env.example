# URL of the CouplesCash .NET API as seen from the SvelteKit server (never from the browser).
# Inside Docker Compose this is http://api:8080
API_URL=http://localhost:8080

# Public origin of the web app. adapter-node uses it to build absolute URLs and for CSRF checks.
ORIGIN=http://localhost:3000

# Display name used in titles and the install hint.
PUBLIC_APP_NAME=CouplesCash

# adapter-node runtime (production only)
# PORT=3000
# HOST=0.0.0.0
# BODY_SIZE_LIMIT=1M
